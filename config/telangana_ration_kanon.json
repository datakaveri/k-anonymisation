{
  "operations": [
    "suppress",
    "hashing_with_salt",
    "masking",
    "k_anonymize"
  ],
  "data_type": "telangana_ration",
  "telangana_ration": {
    "insensitive_columns": [
      "fsc_no",
      "member_id",
      "member_name",
      "gender",
      "mobile",
      "fsc_type",
      "caste",
      "dob",
      "age",
      "hof",
      "member_type",
      "uid",
      "address",
      "district",
      "mandal",
      "fsc_shop_no"
    ],
    "suppress": [
      "member_name",
      "mobile",
      "fsc_type",
      "hof",
      "uid",
      "address",
      "mandal"
    ],
    "hashing_with_salt": [
      "fsc_no"
    ],
    "masking": [
      {
        "column": "dob",
        "masking_char": "*",
        "apply_order": [
          "characters",
          "regex"
        ],
        "characters_to_mask": [
          6,
          7,
          9,
          10
        ]
      }
    ],
    "pass": "pass2",
    "output_path": "anonymized.csv",
    "output_directory": "output",
    "clean_output": true,
    "suppression_limit": 0.05,
    "compute_parameter_grid": false,
    "quasi_identifiers": {
      "categorical": [
        {
          "column": "district"
        }
      ],
      "numerical": [
        {
          "column": "age",
          "encode": false,
          "type": "int"
        }
      ]
    },
    "size": {
      "age": 5
    },
    "k_anonymize": {
      "k": 10
    },
    "_what_this_shows": "The same data with TWO quasi-identifiers instead of one. Age alone is weakly identifying across 100k records, so it needs a very large k before it generalizes at all. Add district and k=10 already does real work \u2014 which is the honest way to choose k: by what the quasi-identifier set can support.",
    "_flow_mode": "DIRECT is required: OLA-1 only knows the categorical names blood group / gender / profession, so district fails under the ORIGINAL flow.",
    "flow_mode": "direct"
  }
}