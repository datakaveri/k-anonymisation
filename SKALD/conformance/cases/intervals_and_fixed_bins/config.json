{
  "data_type": "tabular",
  "tabular": {
    "output_path": "anonymized.csv",
    "suppress": [
      "name"
    ],
    "hashing_with_salt": [
      "id"
    ],
    "shared_hash_salts": true,
    "masking": [
      {
        "column": "note",
        "masking_char": "#",
        "characters_to_mask": [
          1,
          2,
          3
        ]
      }
    ],
    "encrypt": [
      "email",
      {
        "phone": {
          "format_preserving": true
        }
      }
    ],
    "quasi_identifiers": {
      "numerical": [
        {
          "column": "age"
        },
        {
          "column": "pin"
        }
      ],
      "categorical": [
        {
          "column": "gender"
        },
        {
          "column": "blood"
        }
      ]
    },
    "size": {
      "age": 2
    },
    "categorical_hierarchies": {
      "blood": {
        "A+": [
          "A",
          "*"
        ],
        "A-": [
          "A",
          "*"
        ],
        "B+": [
          "B",
          "*"
        ],
        "B-": [
          "B",
          "*"
        ],
        "O+": [
          "O",
          "*"
        ],
        "O-": [
          "O",
          "*"
        ],
        "AB+": [
          "AB",
          "*"
        ],
        "AB-": [
          "AB",
          "*"
        ]
      },
      "gender": {
        "M": [
          "Any"
        ],
        "F": [
          "Any"
        ]
      }
    },
    "k_anonymize": {
      "k": 5
    },
    "suppression_limit": 0.05,
    "qi_constraints": {
      "age": {
        "intervals": [
          {
            "from": 17,
            "to": 30
          },
          {
            "from": 31,
            "to": 50
          },
          {
            "from": 51,
            "to": 70
          },
          {
            "from": 71,
            "to": 99
          }
        ]
      }
    },
    "fixed_bins": {
      "pin": [
        {
          "from": 560000,
          "to": 560050
        },
        {
          "from": 560051,
          "to": 560200
        }
      ]
    }
  }
}
